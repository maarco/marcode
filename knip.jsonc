{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  // These executables are supplied by the OS or installed separately from npm.
  "ignoreBinaries": ["eas", "file", "mkfifo", "pkill", "pkg-config", "plutil", "sips"],
  "workspaces": {
    ".": {
      // Keep vendored reference repositories outside the root project.
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", ".github/**/*.cjs"],
      "entry": [".github/scripts/thread-transfer-report.cjs"],
      "vite": { "entry": [".github/**/*.test.cjs"] },
      "vitest": { "entry": [".github/**/*.test.cjs"] },
    },
    "scripts": {
      // Knip loads its preprocessor through a CLI option, not a source import.
      "entry": ["knip-schemas.ts"],
    },
    "apps/server": {
      // Vite+ pack entries and the launcher used by installed background services.
      "entry": [
        "src/bin.ts!",
        "src/service-launcher.ts!",
        "scripts/cli.ts",
        "src/provider/testFixtures/*.mjs",
      ],
      // Native msgpack acceleration and the Vite+ web build prerequisite.
      "ignoreDependencies": ["msgpackr-extract", "@t3tools/web"],
    },
    "apps/desktop": {
      // Electron loads these bundles by filename rather than importing them.
      "entry": [
        "src/main.ts!",
        "src/preload.ts!",
        "src/preview-pick-preload.ts!",
        "src/preview-pip-preload.ts!",
        "src/preview/Annotation.css!",
      ],
      // The injected runtime resolves Playwright by string; release tooling runs
      // electron-builder from this workspace, outside its package scripts.
      "ignoreDependencies": ["playwright-core", "electron-builder"],
    },
    "apps/web": {
      // Worktree setup invokes this directly from t3.json.
      "entry": ["scripts/warm-dep-cache.ts"],
      // ── Marcode fork seam ──
      // Upstream-owned components with no importer in this fork's shell:
      // FloatingPillNav owns settings navigation and the Connect identity, the
      // floating Code editor replaced the editor scaffolding, and Marcode's
      // xterm drawer and pill-nav chat header replaced the two components that
      // consume panel-tab-close-button and useThreadActionMenu upstream. They
      // are kept, not deleted, so upstream's changes to them keep merging
      // cleanly; deleting them is a product decision, not a sync decision.
      "ignore": [
        "src/components/clerk/MobileClientsUserProfilePage.tsx",
        "src/components/clerk/T3ConnectSidebarSignIn.tsx",
        "src/components/settings/SettingsSidebarNav.tsx",
        "src/components/ui/panel-tab-close-button.tsx",
        "src/editor/api.ts",
        "src/editor/breadcrumb.tsx",
        "src/editor/git-types.ts",
        "src/hooks/useThreadActionMenu.ts",
      ],
      // UI component modules are copied and adapted as cohesive sets. Keep their
      // named subcomponents even before they have callers; the file audit still
      // reports an entire component module when nothing imports it.
      //
      // ── Marcode fork seam ──
      // The 223ff449 sync widened upstream's `knip:check --exports` run from two
      // packages to eight, so it now audits this fork's own modules for the
      // first time. The entries below are Marcode-owned surfaces that export a
      // cohesive set (the floating editor's adapted components, the ambient
      // effects module, the unified workspace tree, the pill-nav shell) or hold
      // one currently-unreferenced helper. They are scoped per path rather than
      // suppressed wholesale so deleting the dead ones later also deletes its
      // entry here. Pruning them is a product decision, not a sync decision.
      "ignoreIssues": {
        "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"],
        "src/editor/*.{ts,tsx}": ["exports", "nsExports", "duplicates"],
        "src/components/chat/chatAmbient*.{ts,tsx}": ["exports", "nsExports", "duplicates"],
        "src/components/unified-workspace/*.{ts,tsx}": ["exports", "nsExports", "duplicates"],
        "src/components/FloatingPillNav.tsx": ["exports", "nsExports"],
        "src/components/PillNavHoverCard.tsx": ["exports", "nsExports"],
        "src/components/SidebarStageBackdrop.tsx": ["exports", "nsExports"],
        "src/components/clerk/T3ConnectUserProfilePage.tsx": ["exports", "nsExports"],
        "src/cloud/managedRelayState.ts": ["exports"],
        "src/hooks/useCopyToClipboard.ts": ["exports"],
        "src/state/entities.ts": ["exports"],
        "src/state/projectFileState.ts": ["exports"],
      },
    },
    "apps/mobile": {
      // Expo loads local config plugins by string; Metro handles platform variants.
      "entry": ["index.ts!", "plugins/*.cjs"],
      // Fonts are configured as asset paths; Expo autolinks the native packages.
      "ignoreDependencies": [
        "@expo-google-fonts/dm-sans",
        "@t3tools/mobile-review-diff-native",
        "@t3tools/mobile-terminal-native",
      ],
    },
    "apps/mobile/modules/t3-markdown-text": {
      // React Native codegen discovers component specifications by filename.
      "entry": ["src/*NativeComponent.ts!"],
    },
    "infra/relay": {
      "entry": ["alchemy.run.ts!", "src/persistence/schema.ts!"],
    },
    "packages/*": {
      // These workspace packages are private to this monorepo.
      "includeEntryExports": true,
    },
    "packages/contracts": {
      "includeEntryExports": true,
      // Every RPC is exported for symmetry with its siblings and consumed by the
      // RpcGroup declared in the same file, so the export audit never sees a
      // cross-module importer for the project-file and VCS ones.
      "ignoreIssues": { "src/rpc.ts": ["exports"] },
    },
    "packages/client-runtime": {
      "includeEntryExports": true,
      "ignoreIssues": { "src/state/projectEntities.ts": ["exports"] },
    },
    "packages/effect-acp": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      // Generated upstream protocol definitions are retained as a complete set.
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
    "packages/effect-codex-app-server": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
  },
}
