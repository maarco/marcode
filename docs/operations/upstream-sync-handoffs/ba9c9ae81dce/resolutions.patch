+    const boot = runBootScript({
+      storage: {
+        [THEME_STORAGE_KEY]: "t3-chat",
+        [THEME_APPEARANCE_MODE_STORAGE_KEY]: "system",
+        "t3code:theme-halves:v1": JSON.stringify({ dark: "gone-theme" }),
