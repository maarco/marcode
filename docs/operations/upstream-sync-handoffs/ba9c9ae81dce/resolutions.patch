+      prefersDark: true,
+    },
+    {
+      name: "a dark-only custom theme stays dark on a light OS",
+      storage: {
+        [THEME_STORAGE_KEY]: "charcoal",
+        [THEME_FOLLOW_SYSTEM_STORAGE_KEY]: "true",
