+      for (let page = 0; page < 10; page += 1) {
+        const snapshot = yield* snapshotQuery.getThreadDetailSnapshot(threadW, {
+          turnLimit: 1,
+          ...(cursor !== undefined ? { beforeCursor: cursor } : {}),
+        });
