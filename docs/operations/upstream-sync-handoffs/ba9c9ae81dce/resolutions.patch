+      },
+      prefersDark: false,
+    },
+    {
+      name: "a legacy mode-suffixed preference is treated as unknown",
+      storage: {
+        [THEME_STORAGE_KEY]: "aurora:dark",
+        [CUSTOM_THEMES_STORAGE_KEY]: JSON.stringify([AURORA_DUAL]),
+      },
+      prefersDark: true,
+    },
+    {
+      name: "a removed custom theme falls back to system",
